# Copy to .env.aws on the EC2 host. Never commit the populated file.
POSTGRES_USER=agenttwinops
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=agenttwinops

SECRET_KEY=replace-with-a-long-random-production-secret
CORS_ORIGINS=["http://REPLACE_WITH_EC2_PUBLIC_IP"]
FRONTEND_URL=http://REPLACE_WITH_EC2_PUBLIC_IP

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://REPLACE_WITH_EC2_PUBLIC_IP/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://REPLACE_WITH_EC2_PUBLIC_IP/api/v1/auth/oauth/github/callback

BACKEND_API_TOKEN=
BACKEND_SERVICE_EMAIL=
BACKEND_SERVICE_PASSWORD=
GEMINI_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000

# Same-origin browser API paths are the safe default for the production proxy.
VITE_API_BASE_URL=/
VITE_AI_API_BASE_URL=/ai
