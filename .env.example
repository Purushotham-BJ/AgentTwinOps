# Copy to .env for local Docker development. Never commit real credentials.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-local-secret
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=agenttwinops
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback
FRONTEND_URL=http://localhost:5173
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BACKEND_SERVICE_EMAIL=
BACKEND_SERVICE_PASSWORD=
