# ── Application ─────────────────────────────────────────────────
APP_NAME=AgentTwinOps
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true

# ── Server ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console

# ── API ─────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/agenttwinops

# ── Redis (placeholder for future phases) ───────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MongoDB (placeholder for future phases) ─────────────────────
MONGODB_URI=mongodb://localhost:27017/agenttwinops

# ── JWT (placeholder for future phases) ─────────────────────────
JWT_SECRET_KEY=replace-me
